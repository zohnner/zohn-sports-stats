/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://a.espncdn.com https://sleepercdn.com https://*.mlbstatic.com https://assets.nhle.com https://staticassets.mlb.com https://i.ytimg.com; connect-src 'self' https://sportsstrata-proxy.zohnwheeler.workers.dev https://sportsstrata-blurb.zohnwheeler.workers.dev https://api.balldontlie.io https://site.api.espn.com https://stats.nba.com https://statsapi.mlb.com https://baseballsavant.mlb.com https://api-web.nhle.com https://api.open-meteo.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-XSS-Protection: 0
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/sitemap.xml
  Cache-Control: no-transform

# sw.js was never given its own cache rule, so Cloudflare's edge cached it
# like any other static .js asset (long default TTL) — that's directly at
# odds with how the browser's own SW update check is supposed to work: the
# browser fetches this exact URL bypassing its OWN http cache to look for
# new bytes, but an edge that's still serving an old cached copy defeats
# that regardless of what the browser does. Root-caused 2026-08-23 (D-116)
# after CACHE_NAME bumps kept failing to reach some real users even after
# the SW's own STATIC_ASSETS + activate-handler cache-busting was correct.
/sw.js
  Cache-Control: no-cache

# data/*.json had no dedicated cache rule either, so it rode Cloudflare's
# same default per-file-type edge caching as any other static asset --
# confirmed 2026-08-23 (D-116) as the actual mechanism behind a "not
# displaying" report that turned out to have nothing to do with a custom
# Cache Rule (owner checked -- none existed on the zone) or with this
# repo's own CACHE_NAME/service-worker logic, both of which were already
# correct. Edge nodes had simply cached older copies of data/awards-*.json
# before this fix existed, under Cloudflare's default (multi-hour) TTL,
# and no header change can retroactively expire an object already sitting
# in an edge cache -- only a manual purge does that, which is what
# resolved the immediate incident. This rule is the actual prevention:
# a short edge TTL so a future award-data push doesn't need a manual
# purge to reach users within a reasonable window. Deliberately not
# no-cache like sw.js -- these files don't carry sw.js's "must always get
# fresh bytes to detect an update" contract, so some edge caching is fine,
# it just needs to not be hours long.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# js/*.js and css/*.css had no dedicated cache rule either, so they rode
# Cloudflare's same default long per-file-type edge caching /data/*.json
# and /sw.js already got bitten by (see above, D-116) -- confirmed
# 2026-08-24 (D-117 Phase 5) when a real fresh browser tab loaded updated
# JS (the deploy clearly reached that edge node) but stale CSS from
# before the deploy (a *different* edge node/cache entry for the same
# push), so the new player-card feature's styling silently didn't apply
# even though the underlying code and data were correct. Same fix as
# /data/*: a short edge TTL so a future js/css push doesn't need a manual
# purge to reach every user within a reasonable window.
/js/*
  Cache-Control: public, max-age=300, must-revalidate

/css/*
  Cache-Control: public, max-age=300, must-revalidate
